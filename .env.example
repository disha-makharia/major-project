# Copy this file to .env and adjust as needed. No real secrets belong here -
# DataMind uses a local Ollama LLM and local embeddings, not paid cloud APIs.

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120

# --- Local embeddings (sentence-transformers, downloaded once from Hugging Face) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage directories (relative or absolute paths) ---
DATA_DIR=./data/datasets
DOCUMENT_DIR=./data/documents
CHROMA_DIR=./data/chroma
CHART_DIR=./generated/charts
DUCKDB_PATH=./data/datamind.duckdb

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.15

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MAX_SQL_RETRIES=2
CORS_ORIGINS=*
